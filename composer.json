{
    "name": "qdequippe/pappers-php-api",
    "description": "PHP Client for Pappers API",
    "keywords": ["pappers", "pappersapi", "api", "client", "openapi", "swagger", "sdk"],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Qdequippe\\Pappers\\Api\\": "generated/",
            "Qdequippe\\Pappers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Qdequippe\\Pappers\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Quentin Dequippe",
            "email": "quentin@dequippe.tech"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "jane-php/open-api-runtime": "^7.4"
    },
    "require-dev": {
        "jane-php/open-api-3": "^7.4"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "generate": "jane open-api generate --config-file=jane-config.php",
        "cs": "tools/bin/php-cs-fixer fix",
        "rector": "tools/bin/rector",
        "jane": "jane-openapi generate --config-file=.jane-openapi.php",
        "build": [
            "@jane",
            "@rector",
            "@cs"
        ]
    },
    "scripts-descriptions": {
        "cs": "Fix code style",
        "rector": "Run Rector",
        "jane": "Generate the SDK",
        "build": "Generate the SDK, then run Rector and fix code style"
    }
}
